	language = {en},
	month = jan,
	number = {1},
	pages = {e503},
	shorttitle = {Crop models and their use in assessing crop production and food security},
	title = {Crop models and their use in assessing crop production and food security: {A} review},
	url = {https://onlinelibrary.wiley.com/doi/10.1002/fes3.503},
	urldate = {2025-04-18},
